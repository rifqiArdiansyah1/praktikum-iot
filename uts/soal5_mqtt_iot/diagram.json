{
  "version": 1,
  "author": "UTS Embedded System - Soal 5",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -80, "left": -160, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay1", "top": -80, "left": 180, "attrs": {} },
    { "type": "wokwi-led", "id": "lamp1", "top": 120, "left": 220, "attrs": { "color": "yellow", "label": "LAMPU BEBAN" } },
    { "type": "wokwi-resistor", "id": "r220", "top": 80, "left": 160, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "ldr1:VCC", "esp:3V3", "red", [ "v-30", "h100" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "v-20", "h90" ] ],
    [ "ldr1:AO", "esp:34", "green", [ "v40", "h120" ] ],

    [ "esp:5V", "relay1:VCC", "red", [ "h20", "v-80" ] ],
    [ "esp:GND.2", "relay1:GND", "black", [ "h30", "v-60" ] ],
    [ "esp:19", "relay1:IN", "purple", [ "h40", "v-40" ] ],
    
    [ "esp:3V3", "relay1:COM", "red", [ "h50", "v-100" ] ],
    [ "relay1:NO", "r220:1", "orange", [ "v40" ] ],
    [ "r220:2", "lamp1:A", "orange", [ "h20" ] ],
    [ "lamp1:C", "esp:GND.2", "black", [ "v30", "h-120" ] ]
  ],
  "dependencies": {}
}
