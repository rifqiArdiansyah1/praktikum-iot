{
  "version": 1,
  "author": "UTS Embedded System - Soal 1",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 180, "attrs": { "color": "red", "label": "LED PWM" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 120, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 100, "left": -120, "attrs": { "color": "green", "label": "SWITCH" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:16", "r1:1", "orange", [ "h20" ] ],
    [ "r1:2", "led1:A", "orange", [ "h20" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v20", "h-80" ] ],
    [ "esp:4", "btn1:1.l", "blue", [ "h-20" ] ],
    [ "btn1:2.l", "esp:GND.1", "black", [ "h-20", "v-60" ] ]
  ],
  "dependencies": {}
}
